{
  "name": "memory-game-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "npm run dev -w @memory/web",
    "web:build": "npm run build -w @memory/web",
    "android": "npm run android -w @memory/mobile",
    "mobile:start": "npm run start -w @memory/mobile",
    "test": "npm run test -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "web:start": "npm run start -w @memory/web",
    "api": "npm run dev -w @memory/api",
    "api:start": "npm run start -w @memory/api"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
